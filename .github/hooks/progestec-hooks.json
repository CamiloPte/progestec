{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-hooks/session-context.ps1",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent-hooks/guard-destructive-tools.ps1",
        "timeout": 10
      }
    ]
  }
}
