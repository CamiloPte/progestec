# =============================================================================
# ProGesTec - .gitignore
# =============================================================================

# ---------- Secretos y entornos locales ----------
.env
.env.*
!.env.example
*.env.local
*.pem
*.key

# ---------- Python / FastAPI ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtualenvs
.venv/
venv/
env/
ENV/

# Pytest / coverage / mypy / ruff
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Alembic - mantener migraciones, ignorar caches
alembic/__pycache__/
alembic/versions/__pycache__/

# Logs de la app
app/logs/*.log
app/logs/*.log.*
*.log

# Uploads (archivos subidos por usuarios)
uploads/
media/

# ---------- Node / Angular ----------
node_modules/
.angular/cache/
.angular/.angular/
dist/
out-tsc/
bazel-out/
*.js.map
*.css.map
/coverage/
/libpeerconnection.log
yarn-error.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
testem.log
/typings

# ---------- IDEs y editores ----------
.idea/
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Sistema operativo ----------
$RECYCLE.BIN/
ehthumbs.db
ehthumbs_vista.db

# ---------- Backups y dumps ----------
backup/*.backup
backup/*.sql
backup/*.dump
backup/*.tar.gz
*.bak

# ---------- Docker ----------
docker-compose.override.yml
.docker/

# ---------- Archivos generados / temporales ----------
*.tmp
*.temp
*.cache
.history/

# ---------- Kiro - mantener specs y steering, ignorar working files ----------
.kiro/.cache/
.kiro/tmp/
