# =============================================================================
# ProGesTec - Variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y rellena con tus valores. NUNCA subir `.env` al repo.
# =============================================================================

# === Seguridad ===
# Generar uno aleatorio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Base de datos (MySQL principal) ===
DB_HOST=db
DB_PORT=3306
DB_USER=user
DB_PASSWORD=change_me
DB_NAME=progestec_db
# Si lo dejas vacío, se construye a partir de las variables de arriba
DB_URL=

# === Archivos / media ===
MEDIA_ROOT=uploads
MEDIA_URL=/uploads

# === Email / SMTP ===
# Si usas Gmail: crear una "Contraseña de aplicación" en
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=ProGesTec - Servicio Técnico
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# === Datos de la empresa (aparecen en facturas y emails) ===
COMPANY_NAME=ProGesTec
COMPANY_PHONE=+57 300 000 0000
COMPANY_EMAIL=
COMPANY_ADDRESS=Barranquilla, Colombia
COMPANY_WEBSITE=https://progestec.com

# === Frontend ===
FRONTEND_URL=http://localhost:4200

# === CORS ===
ALLOW_ALL_ORIGINS=True
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# =============================================================================
# Catálogo (microservicio) - se configura en catalog-service/.env
# =============================================================================
